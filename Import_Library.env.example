# ============================================================================
# Configuration de Import_Library.sh
# Complétez et renommez ce fichier Import_Library.env
# ============================================================================

# Token "API Read Access Token" TMDB.
# Il s'agit bien du token à utiliser comme argument GET `api_key=`...
TMDB_TOKEN=""

# Instance de scene-release-parser.
# Mettre l'URL du service
# Ou "LOCAL" pour l'exécuter en local via à Docker: RELEASE_PARSER_URL="LOCAL"
RELEASE_PARSER_URL="https://<URL_À_COMPLÉTER>"

# Nombre maximum de résultats TMDB proposés dans le TUI.
TMDB_MAX_RESULTS="20"

# Langue de recherche sur TMDB et pour le nom des dossiers
# Au format RFC 5646 ('fr-FR', 'en-US', etc)
TMDB_LANG="fr-FR"

# Niveau de log (CRITICAL/ERROR/WARN/INFO/DEBUG), INFO par défaut
LOG_LEVEL=INFO

# Template des dossier, voir le README pour la liste des tags utilisables
# Défaut: '{{title-fr}} ({{year}}) [tmdbid-{{tmdbid}}]'
FOLDER_TEMPLATE='{{title-fr}} ({{year}}) [tmdbid-{{tmdbid}}]'
